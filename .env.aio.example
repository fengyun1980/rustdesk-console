# ========================================================================
# RustDesk Console — All-in-One 一键部署环境变量模板
# ========================================================================
# 使用：复制本文件为 .env，然后按需修改即可。
#   cp .env.aio.example .env
#
# 必填项（没有这些 compose 会报错）：
#   JWT_SECRET          — 生产环境必须改成随机强密钥
#   ADMIN_PASSWORD      — 首次登录用的管理员密码
#   SERVER_MANAGEMENT_TOKEN — RustDesk Server 管理 token（≥32 字符）
#
# 快速生成随机值：
#   openssl rand -base64 48 | tr -d '\n'       # 给 JWT_SECRET 用
#   openssl rand -hex 32                        # 给 SERVER_MANAGEMENT_TOKEN 用
# ========================================================================


# —— JWT / 登录 ——
# Console 用来签发 JWT 的密钥，生产环境必须改成随机强密钥
JWT_SECRET=please-change-this-to-a-random-string

# 首次启动时创建的 admin 账户密码（用户名固定 databk）
ADMIN_PASSWORD=please-change-this-password


# —— RustDesk Server ——
# Console 后端对接 hbbs/hbbr 管理 API 的 token，长度 ≥ 32 字符。
# 这个值会同时传给 hbbs 和 hbbr 容器，以及 Console 后端，自动注入到
# system_settings 表，登录后无需在 Console 里再手动配置。
SERVER_MANAGEMENT_TOKEN=please-generate-a-random-hex-string-of-at-least-32-characters

# 可选：hbbs 对外发布的中继地址（客户端写死的 relay 发现地址）。
# 如果客户端直接使用 IP 连接，可以留空；使用域名/公网 IP 时填写。
# 例：RUSTDESK_RELAY_ADDRESS=your-domain.com:21117
# 例：RUSTDESK_RELAY_ADDRESS=192.168.1.100:21117
RUSTDESK_RELAY_ADDRESS=

# 可选：hbbr 的 relay ID（留空默认 relay-1）
HBBR_RELAY_ID=relay-1

# 可选：Console Server Management 里显示的节点信息
SERVER_MANAGEMENT_NODE_ID=rustdesk
SERVER_MANAGEMENT_NODE_NAME=RustDesk


# —— 数据库 ——
# 默认使用 SQLite（零配置）。切换 MySQL 时改 DB_TYPE 并填下面几项。
DB_TYPE=sqlite

# DB_TYPE=mysql 或 mariadb 时生效：
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=rustdesk_console
# DB_PASSWORD=your-password
# DB_DATABASE=rustdesk_console

# 启动时是否自动执行迁移（首次启动和升级时保持 1）
DB_MIGRATE_ON_START=1


# —— 日志 ——
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log


# —— 数据目录（可选）——
# 所有数据默认放在 compose 文件同级的 ./data 下；
# 想指向其它位置可以覆写。留空注释掉即用默认值。
# CONSOLE_DATA_DIR=./data
# SERVER_DATA_DIR=./data/server
# RELAY_DATA_DIR=./data/server-relay
